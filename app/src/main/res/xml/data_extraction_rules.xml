<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive database storing medical logs and wellness data -->
        <exclude domain="database" path="notel_db"/>
        <exclude domain="database" path="notel_db-journal"/>
        <exclude domain="database" path="notel_db-shm"/>
        <exclude domain="database" path="notel_db-wal"/>
        
        <!-- Exclude credentials, access tokens, and settings stored in sharedpreferences/datastore -->
        <exclude domain="sharedpref" path="."/>
        
        <!-- Exclude health/knowledge documents -->
        <exclude domain="file" path="knowledge_docs"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive database storing medical logs and wellness data -->
        <exclude domain="database" path="notel_db"/>
        <exclude domain="database" path="notel_db-journal"/>
        <exclude domain="database" path="notel_db-shm"/>
        <exclude domain="database" path="notel_db-wal"/>
        
        <!-- Exclude credentials, access tokens, and settings stored in sharedpreferences/datastore -->
        <exclude domain="sharedpref" path="."/>
        
        <!-- Exclude health/knowledge documents -->
        <exclude domain="file" path="knowledge_docs"/>
    </device-transfer>
</data-extraction-rules>