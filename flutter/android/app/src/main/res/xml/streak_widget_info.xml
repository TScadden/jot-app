<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone streak widget (Nov 18, 2026) — a wide 4x2-ish
     banner matching the in-app streak banner's aspect.
     updatePeriodMillis is the platform minimum (30 min): it
     exists for the day-rollover refresh; the primary refresh is
     the explicit WidgetSync update on every streak push. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/streak_widget"
    android:previewLayout="@layout/streak_widget"
    android:previewImage="@drawable/widget_preview"
    android:description="@string/streak_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
