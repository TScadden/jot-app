<?xml version="1.0" encoding="utf-8"?>
<!-- Streak banner (not-done) background: dark navy gradient,
     matching the streak mocks (#1B2A52 → #0D1428). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:angle="270"
        android:startColor="#1B2A52"
        android:endColor="#0D1428" />
    <stroke
        android:width="1dp"
        android:color="#26355F" />
</shape>
