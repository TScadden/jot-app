<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone streak widget — COMPACT face (~2x1 cells, Nov 19,
     2026). The founder's Duolingo reference: flame + count, ONE
     greeting line, Bandit peeking small from the bottom edge, on
     the same dark navy card (widget_banner_bg) as the banner.

     COPY (Juno ruling, JUNO-COMPACT-COPY.md, Nov 19, 2026):
     exactly TWO text elements — the flame + count row and the
     payload greeting verbatim (widget_streak_greeting, with the
     §9d empty-string collapse). There is NO subline at this size
     in either state: this layout deliberately contains no subline
     view and the provider never binds widget_streak_subline here,
     so no ellipsized / maxLines=1 truncation path for the §9b
     string can exist. The greeting slot is sized against the
     longest ruled greeting, "See you tomorrow!" (17 chars,
     ~115dp at 13sp bold vs ~126dp usable at the 150dp design
     width with the banner's 12dp side padding) — it fits
     UNTRUNCATED, with no ellipsize attribute anywhere.

     STRUCTURE (same anti-occlusion discipline as the banner fix):
     vertical LinearLayout root — the text column is
     layout_weight=1 inside its own clipped area and Bandit sits
     in a FIXED-HEIGHT (20dp) bottom container with
     clipChildren=true, so the two zones are disjoint rectangles
     at every size in the compact bucket (110-180dp wide x
     50-80dp tall) and text can never enter the Bandit zone.
     Inside its container the bitmap keeps the peek crop: 32x22dp
     with marginBottom=-2dp aligns the bitmap top with the
     container top and crops ~9% at the bottom edge; the nose
     (y 0.78-0.85 of the bitmap, measured) stays fully visible.

     The android:text defaults below are the picker-preview /
     first-paint values only (this layout is the provider's
     previewLayout); StreakWidgetProvider overwrites count,
     greeting, flame and pose on every render.
     RemoteViews-safe classes only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_banner_bg"
    android:clipChildren="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/streak_widget_flame"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Streak flame"
                android:src="@drawable/ic_widget_flame_grey" />

            <TextView
                android:id="@+id/streak_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="26"
                android:textColor="#8E97B8"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/streak_widget_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Hey Tyson."
            android:textColor="#F0EEFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/streak_widget_bandit_zone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:clipChildren="true">

        <ImageView
            android:id="@+id/streak_widget_bandit"
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-2dp"
            android:contentDescription="Bandit"
            android:scaleType="fitCenter"
            android:src="@drawable/bandit_peek" />
    </FrameLayout>
</LinearLayout>
