<?xml version="1.0" encoding="utf-8"?>
<!-- Round 50 — home-screen widget surface. Fill is the vitals
     strip's exact surface token, NotelColors.legacyDarkScrim
     (0x4D000000, black at 30%) from lib/src/theme/notel_colors.dart,
     with the strip's hairline (legacyDarkHairline, 0x1AFFFFFF) as a
     1dp stroke. Corner radius 24dp: deliberately much rounder than
     the in-app strip's 12dp card (Apple-widget polish, founder spec). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#4D000000" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
    <corners android:radius="24dp" />
</shape>
