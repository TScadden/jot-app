<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Round 5: required for the real login API call (HTTPS only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Round 30: local reminder notifications (flutter_local_notifications).
         POST_NOTIFICATIONS is requested only after an in-app rationale
         dialog: from the Settings toggle flow, after its in-app
         explanation dialog (Round 30), and from the Reminders create
         flow (Round 47 fix round), where the exact-alarm gate runs
         first and the system request fires only from the rationale
         dialog's Allow button (never at startup, never from a
         background path). SCHEDULE_EXACT_ALARM is the
         requestable exact-alarm permission (granted by the user in
         system settings); RECEIVE_BOOT_COMPLETED lets the plugin
         restore scheduled reminders after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Round 10: weather icon tap asks for precise location to upgrade
         the IP-based weather to GPS weather. While-in-use only — no
         background location. Requested only on user tap, never at
         startup. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Round 12: Health Connect. The 14 record-type reads + history, exactly
         matching the native app's manifest. READ_HEALTH_DATA_IN_BACKGROUND is
         intentionally NOT declared/requested here — background access is a
         separate Dart-side gate granted via Health Connect settings. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Round 54: device calendar for the Health Coach, matching the
         native app's manifest. Both are requested together, at
         runtime only, at the first calendar proposal approval
         (native CoachScreen.kt:89-113) — never at startup. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <application
        android:label="Tabs Lab"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Round 12: lets Health Connect show a permission-rationale entry
                 point for this app, matching the native app's manifest. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Round 12b: system entry point for viewing this app's health
                 permission usage, matching the native app's manifest. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
            <!-- Round 12b: REQUIRED — tells the Health Connect permission
                 controller which health permissions this app may request.
                 Without this, the permission UI flashes and closes with an
                 empty grant set. Points at res/values/health_permissions.xml,
                 matching the native app. -->
            <meta-data
                android:name="health_permissions"
                android:resource="@array/health_permissions" />
        </activity>
        <!-- Round 30: flutter_local_notifications receivers — the first
             posts scheduled notifications when their alarm fires; the
             second restores schedules after BOOT_COMPLETED /
             MY_PACKAGE_REPLACED (per the plugin's setup docs). -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Round 48: FileProvider for the Key Metrics CSV export share
             sheet (authority mirrors the native app's
             "${applicationId}.provider"; paths in res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Round 50: home-screen vitals widget (native RemoteViews;
             data arrives via the home_widget bridge from Dart's
             WidgetSync). Exported=false: widget updates are delivered
             by the system AppWidgetService. -->
        <receiver
            android:name=".VitalsWidgetProvider"
            android:exported="false"
            android:label="Tabs vitals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vitals_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
